// Well-typed program using references (#references, #sequencing, #unit-type)
language core;
extend with #unit-type, #references, #let-bindings, #sequencing;

// Increment value at reference by 1
fn inc_ref(ref : &Nat) -> Unit {
  return ref := succ(*ref)
}

// Increment reference 3 times and return new value
fn inc3(ref : &Nat) -> Nat {
  return
    inc_ref(ref);
    inc_ref(ref);
    inc_ref(ref);
    *ref
}

fn main(n : Nat) -> Nat {
  return let ref = new(n) in inc3(ref)
}
